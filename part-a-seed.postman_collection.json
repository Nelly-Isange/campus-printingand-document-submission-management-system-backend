{
  "info": {
    "name": "Part A seed - empty Part A database ONLY",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Optional: the original endpoint seeding sequence. Use on an EMPTY database with the Part A application. Do not run on the supplied preloaded database, or after the Part D rules are enabled."
