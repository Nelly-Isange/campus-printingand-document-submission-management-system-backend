    {
      "key": "missingId",
      "value": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "item": [
    {
      "name": "Step 0 - Part A seed (run ONCE before Part D)",
      "description": "Run on an empty Part A database, before safe saving is added. Uses the exam October and November 2026 data. Later keep this database. Do not rerun against the final safe-save endpoint.",
      "item": [
        {
          "name": "A2 seed print service 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/print-services/save",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Black and White\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Exact message\", function () { pm.expect(pm.response.text()).to.eql(\"Print service saved successfully\"); });"
